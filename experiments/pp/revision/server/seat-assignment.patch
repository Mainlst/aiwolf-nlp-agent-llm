+// TeamIndexes returns the frozen optimizer index for each team.  The index is
+// also the intended in-game seat for a scheduled match, so callers must not
+// reconstruct seating from Go map iteration order.
+func (mo *MatchOptimizer) TeamIndexes() map[string]int {
+	mo.mu.RLock()
+	defer mo.mu.RUnlock()
+	indexes := make(map[string]int, len(mo.IdxTeamMap))
+	for index, team := range mo.IdxTeamMap {
+		indexes[team] = index
+	}
+	return indexes
+}
